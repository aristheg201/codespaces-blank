function minecraftKeyFromCode(code:string):string {
 const map:Record<string,string>={Space:'space',Enter:'enter',Escape:'escape',Tab:'tab',Backspace:'backspace',CapsLock:'caps.lock',ShiftLeft:'left.shift',ShiftRight:'right.shift',ControlLeft:'left.control',ControlRight:'right.control',AltLeft:'left.alt',AltRight:'right.alt',ArrowUp:'up',ArrowDown:'down',ArrowLeft:'left',ArrowRight:'right',Delete:'delete',Insert:'insert',Home:'home',End:'end',PageUp:'page.up',PageDown:'page.down'};
 if(map[code])return 'key.keyboard.'+map[code];
 if(/^Key[A-Z]$/.test(code))return 'key.keyboard.'+code.slice(3).toLowerCase();
 if(/^Digit[0-9]$/.test(code))return 'key.keyboard.'+code.slice(5);
 if(/^F([1-9]|1[0-9]|2[0-4])$/.test(code))return 'key.keyboard.'+code.toLowerCase();
 if(/^Numpad[0-9]$/.test(code))return 'key.keyboard.keypad.'+code.slice(6);
 return 'key.keyboard.unknown';
}
function KeybindManager(){
 const {snapshot,busy,rescan}=useManager();
 const [policy,setPolicy]=useState<KeybindPolicy>({schema:1,rules:[],updatedAt:0});
 const [q,setQ]=useState('');const [capture,setCapture]=useState<number|null>(null);const [saving,setSaving]=useState(false);const [drag,setDrag]=useState(false);const [error,setError]=useState('');
 const reload=async()=>{setError('');try{setPolicy(await window.bestiary.getKeybindPolicy())}catch(e){setError(e instanceof Error?e.message:String(e))}};
 useEffect(()=>{void reload()},[snapshot.root]);
 useEffect(()=>{if(capture===null)return;const onKey=(e:KeyboardEvent)=>{e.preventDefault();e.stopPropagation();const key=minecraftKeyFromCode(e.code);if(key==='key.keyboard.unknown')return;setPolicy(p=>({...p,rules:p.rules.map((r,i)=>i===capture?{...r,key}:r)}));setCapture(null)};window.addEventListener('keydown',onKey,true);return()=>window.removeEventListener('keydown',onKey,true)},[capture]);
 const patch=(i:number,next:Partial<KeybindRule>)=>setPolicy(p=>({...p,rules:p.rules.map((r,n)=>n===i?{...r,...next}:r)}));
 const save=async()=>{setSaving(true);setError('');try{setPolicy(await window.bestiary.saveKeybindPolicy(policy));await rescan()}catch(e){setError(e instanceof Error?e.message:String(e))}finally{setSaving(false)}};
 const importPath=async(path?:string)=>{setSaving(true);setError('');try{setPolicy(await window.bestiary.importKeybindsFromOptions(path));await rescan()}catch(e){setError(e instanceof Error?e.message:String(e))}finally{setSaving(false)}};
 const choose=async()=>{const p=await window.bestiary.chooseOptionsFile();if(p)await importPath(p)};
 const onDrop=async(e:React.DragEvent)=>{e.preventDefault();setDrag(false);const file=e.dataTransfer.files?.[0];if(!file)return;const p=window.bestiary.getPathForFile(file);if(!p.toLowerCase().endsWith('options.txt')){setError('File kéo vào phải là options.txt.');return}await importPath(p)};
 const enabled=policy.rules.filter(r=>r.enabled);const groups=new Map<string,string[]>();for(const r of enabled){if(!groups.has(r.key))groups.set(r.key,[]);groups.get(r.key)!.push(r.id)}const conflicts=[...groups.entries()].filter(([,ids])=>ids.length>1);
 const visible=policy.rules.map((r,i)=>({r,i})).filter(({r})=>`${r.id} ${r.label} ${r.key}`.toLowerCase().includes(q.toLowerCase()));
 return <div className="h-full overflow-auto p-7" onDragOver={e=>{e.preventDefault();setDrag(true)}} onDragLeave={()=>setDrag(false)} onDrop={e=>void onDrop(e)}>
  <div className="flex items-end gap-4"><div><div className="text-[10px] font-black tracking-[.2em] text-red-400">02 · KEYBINDS</div><h1 className="mt-1 text-3xl font-black">Điều khiển trong game</h1><p className="mt-1 max-w-3xl text-xs leading-5 text-zinc-500">Danh sách được sinh từ <b>options.txt</b> thật của Minecraft. DEFAULT bám phím player; LOCKED ép lại trước khi Launcher chạy game. Không tự tạo action ma nữa.</p></div><div className="ml-auto flex gap-2"><button onClick={()=>void choose()} disabled={busy||saving} className="rounded-xl border border-zinc-700 bg-zinc-900 px-4 py-3 text-[9px] font-black">CHỌN OPTIONS.TXT</button><button onClick={()=>void importPath()} disabled={busy||saving||!policy.sourceAvailable} className="rounded-xl border border-zinc-700 bg-zinc-900 px-4 py-3 text-[9px] font-black">QUÉT LẠI</button><button onClick={()=>void save()} disabled={busy||saving} className="rounded-xl bg-red-500 px-5 py-3 text-[9px] font-black">LƯU POLICY</button></div></div>
  <div className={`mt-4 rounded-2xl border p-4 ${drag?'border-red-500 bg-red-500/10':'border-zinc-800 bg-zinc-950/70'}`}><div className="text-[8px] font-black tracking-[.15em] text-zinc-600">OPTIONS.TXT SOURCE</div><div className={`mt-1 break-all text-xs ${policy.sourceAvailable?'text-emerald-300':'text-amber-300'}`}>{policy.sourceAvailable&&policy.sourcePath?policy.sourcePath:'CHƯA CHỌN · Kéo options.txt vào đây hoặc bấm CHỌN OPTIONS.TXT'}</div></div>
  {error&&<div className="mt-3 rounded-xl border border-red-500/30 bg-red-500/10 p-3 text-[10px] text-red-300">{error}</div>}
  <div className="mt-5 grid grid-cols-[1fr_210px_210px] gap-3"><input className="input" value={q} onChange={e=>setQ(e.target.value)} placeholder="Tìm action / key..."/><div className="panel rounded-xl px-4 py-3"><div className="text-[8px] font-black text-zinc-600">RULES TỪ FILE</div><div className="mt-1 text-xl font-black">{policy.rules.length}</div></div><div className={`panel rounded-xl px-4 py-3 ${conflicts.length?'border-amber-500/30':''}`}><div className="text-[8px] font-black text-zinc-600">CONFLICT</div><div className={`mt-1 text-xl font-black ${conflicts.length?'text-amber-300':'text-emerald-300'}`}>{conflicts.length}</div></div></div>
  {conflicts.length>0&&<div className="mt-3 rounded-xl border border-amber-500/25 bg-amber-500/5 p-3 text-[10px] text-amber-200">{conflicts.map(([key,ids])=><div key={key}><b>{key}</b> → {ids.join(' · ')}</div>)}</div>}
  <section className="panel mt-4 overflow-hidden rounded-2xl"><div className="grid grid-cols-[64px_minmax(300px,1.3fr)_minmax(210px,.8fr)_220px_120px] gap-3 border-b border-zinc-800 bg-zinc-950 px-4 py-3 text-[8px] font-black text-zinc-600"><span>ON</span><span>ACTION</span><span>KEY</span><span>CAPTURE</span><span>MODE</span></div>{visible.map(({r,i})=><div key={r.id} className={`grid grid-cols-[64px_minmax(300px,1.3fr)_minmax(210px,.8fr)_220px_120px] items-center gap-3 border-b border-zinc-900 px-4 py-3 ${r.enabled?'':'opacity-45'}`}><button onClick={()=>patch(i,{enabled:!r.enabled})} className={`h-9 rounded-xl border text-[9px] font-black ${r.enabled?'border-emerald-500/30 bg-emerald-500/10 text-emerald-300':'border-zinc-800 bg-zinc-950 text-zinc-600'}`}>{r.enabled?'ON':'OFF'}</button><div className="min-w-0"><div className="truncate text-xs font-bold">{r.label}</div><div className="mt-1 truncate font-mono text-[9px] text-zinc-600">{r.id}</div></div><input className="input font-mono text-[10px]" value={r.key} onChange={e=>patch(i,{key:e.target.value})}/><button onClick={()=>setCapture(i)} className={`rounded-xl border px-3 py-3 text-[9px] font-black ${capture===i?'border-red-500 bg-red-500/10 text-red-300':'border-zinc-700 bg-zinc-900 text-zinc-300'}`}>{capture===i?'NHẤN PHÍM...':'GHI PHÍM BÀN PHÍM'}</button><select className="input" value={r.mode} onChange={e=>patch(i,{mode:e.target.value as KeybindRule['mode']})}><option value="default">DEFAULT</option><option value="locked">LOCKED</option></select></div>)}</section>
  <div className="mt-3 text-[9px] leading-4 text-zinc-600">Nguồn options.txt chỉ lưu cục bộ trong <b>.bestiary/keybind-source.json</b>. Distribution chỉ nhận <b>config/bestiary-keybinds.json</b>, không nhận đường dẫn máy quản trị.</div>
 </div>;
}

