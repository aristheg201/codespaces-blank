+function handleMinecraftBootstrapProgress(payload: unknown): void {
+  if (!payload || typeof payload !== 'object') return;
+  const data = payload as Record<string, unknown>;
+  const kind = typeof data.type === 'string' ? data.type : 'minecraft';
+  const normalized = kind.toLowerCase();
+
+  let start = 90;
+  let end = 99;
+  let title = 'Đang chuẩn bị Minecraft';
+  if (normalized.includes('native')) {
+    start = 90; end = 91; title = 'Đang chuẩn bị native libraries';
+  } else if (normalized.includes('class') || normalized.includes('librar')) {
+    start = 91; end = 96; title = 'Đang tải thư viện Minecraft';
+  } else if (normalized.includes('asset')) {
+    start = 96; end = 99; title = 'Đang tải assets Minecraft';
+  } else if (normalized.includes('version-jar')) {
+    start = 90; end = 91.5; title = 'Đang tải Minecraft';
+  }
+
+  const task = Number(data.task);
+  const totalTasks = Number(data.total);
+  const currentBytes = Number(data.current);
+  const totalBytes = Number(data.total);
+  let ratio = 0;
+  let detail = kind;
+
+  if (Number.isFinite(task) && Number.isFinite(totalTasks) && totalTasks > 0 && data.task !== undefined) {
+    ratio = Math.max(0, Math.min(1, task / totalTasks));
+    detail = `${Math.floor(task).toLocaleString()} / ${Math.floor(totalTasks).toLocaleString()} file`;
+  } else if (Number.isFinite(currentBytes) && Number.isFinite(totalBytes) && totalBytes > 0) {
+    ratio = Math.max(0, Math.min(1, currentBytes / totalBytes));
+    const name = typeof data.name === 'string' && data.name ? data.name : kind;
+    detail = `${name} · ${(currentBytes / 1024 / 1024).toFixed(1)} / ${(totalBytes / 1024 / 1024).toFixed(1)} MB`;
+  }
+
+  minecraftBootstrapPercent = Math.max(minecraftBootstrapPercent, start + (end - start) * ratio);
+  sendProgress({
+    stage: 'launching',
+    percent: minecraftBootstrapPercent,
+    title,
+    detail,
+    speedMBps: 0,
+    etaSeconds: null,
+  });
+}
