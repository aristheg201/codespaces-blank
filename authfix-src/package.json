{
  "name": "bestiary-pack-manager",
  "version": "6.0.1",
  "private": true,
  "description": "Bestiary client pack release manager",
  "main": "dist/main/index.js",
  "author": "Bestiary",
  "license": "UNLICENSED",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').rmSync('release',{recursive:true,force:true})\"",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run clean && npm run build:main && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.main.json --noEmit",
    "dist:win": "npm run build && electron-builder --config electron-builder.json --win nsis --x64"
  },
  "dependencies": {
    "adm-zip": "0.5.16",
    "axios": "1.11.0",
    "electron-store": "10.0.1",
    "fs-extra": "11.3.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zustand": "5.0.7"
  },
  "devDependencies": {
    "@types/adm-zip": "0.5.7",
    "@types/fs-extra": "11.0.4",
    "@types/node": "22.17.2",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.21",
    "electron": "37.4.0",
    "electron-builder": "26.0.12",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.2",
    "vite": "7.1.2"
  }
}
