function minecraftKeyFromCode(code:string):string {
 const map:Record<string,string>={Space:'space',Enter:'enter',Escape:'escape',Tab:'tab',Backspace:'backspace',CapsLock:'caps.lock',ShiftLeft:'left.shift',ShiftRight:'right.shift',ControlLeft:'left.control',ControlRight:'right.control',AltLeft:'left.alt',AltRight:'right.alt',ArrowUp:'up',ArrowDown:'down',ArrowLeft:'left',ArrowRight:'right',Delete:'delete',Insert:'insert',Home:'home',End:'end',PageUp:'page.up',PageDown:'page.down'};
 if(map[code])return 'key.keyboard.'+map[code];
 if(/^Key[A-Z]$/.test(code))return 'key.keyboard.'+code.slice(3).toLowerCase();
 if(/^Digit[0-9]$/.test(code))return 'key.keyboard.'+code.slice(5);
 if(/^F([1-9]|1[0-9]|2[0-4])$/.test(code))return 'key.keyboard.'+code.toLowerCase();
 if(/^Numpad[0-9]$/.test(code))return 'key.keyboard.keypad.'+code.slice(6);
 return 'key.keyboard.unknown';
}
function KeybindManager(){
 const {snapshot,busy,rescan}=useManager();const [policy,setPolicy]=useState<KeybindPolicy>({schema:1,rules:[],updatedAt:0});const [q,setQ]=useState('');const [capture,setCapture]=useState<number|null>(null);const [saving,setSaving]=useState(false);
 useEffect(()=>{let active=true;void window.bestiary.getKeybindPolicy().then(p=>{if(active)setPolicy(p)});return()=>{active=false}},[snapshot.root]);
 useEffect(()=>{if(capture===null)return;const onKey=(e:KeyboardEvent)=>{e.preventDefault();e.stopPropagation();const key=minecraftKeyFromCode(e.code);if(key==='key.keyboard.unknown')return;setPolicy(p=>({...p,rules:p.rules.map((r,i)=>i===capture?{...r,key}:r)}));setCapture(null)};window.addEventListener('keydown',onKey,true);return()=>window.removeEventListener('keydown',onKey,true)},[capture]);
 const patch=(i:number,next:Partial<KeybindRule>)=>setPolicy(p=>({...p,rules:p.rules.map((r,n)=>n===i?{...r,...next}:r)}));
 const remove=(i:number)=>setPolicy(p=>({...p,rules:p.rules.filter((_,n)=>n!==i)}));
 const add=()=>setPolicy(p=>({...p,rules:[...p.rules,{id:'key_mod.action',label:'Hành động mới',key:'key.keyboard.unknown',mode:'default',enabled:true}]}));
 const save=async()=>{setSaving(true);try{setPolicy(await window.bestiary.saveKeybindPolicy(policy));await rescan()}finally{setSaving(false)}};
 const importOptions=async()=>{setSaving(true);try{setPolicy(await window.bestiary.importKeybindsFromOptions());await rescan()}finally{setSaving(false)}};
 const enabled=policy.rules.filter(r=>r.enabled);const groups=new Map<string,string[]>();for(const r of enabled){if(!groups.has(r.key))groups.set(r.key,[]);groups.get(r.key)!.push(r.id)}const conflicts=[...groups.entries()].filter(([,ids])=>ids.length>1);
 const visible=policy.rules.map((r,i)=>({r,i})).filter(({r})=>`${r.id} ${r.label} ${r.key}`.toLowerCase().includes(q.toLowerCase()));
 return <div className="h-full overflow-auto p-7"><div className="flex items-end gap-4"><div><div className="text-[10px] font-black tracking-[.2em] text-red-400">02 · KEYBINDS</div><h1 className="mt-1 text-3xl font-black">Điều khiển trong game</h1><p className="mt-1 max-w-3xl text-xs leading-5 text-zinc-500">Chỉ quản lý các dòng <b>key_*</b>. DEFAULT tôn trọng phím player đã tự đổi; LOCKED ép lại trước mỗi lần Launcher chạy Minecraft.</p></div><div className="ml-auto flex gap-2"><button onClick={()=>void importOptions()} disabled={busy||saving} className="rounded-xl border border-zinc-700 bg-zinc-900 px-4 py-3 text-[9px] font-black">ĐỌC OPTIONS.TXT</button><button onClick={add} className="rounded-xl border border-zinc-700 bg-zinc-900 px-4 py-3 text-[9px] font-black">+ THÊM KEYBIND</button><button onClick={()=>void save()} disabled={busy||saving} className="rounded-xl bg-red-500 px-5 py-3 text-[9px] font-black">LƯU POLICY</button></div></div><div className="mt-5 grid grid-cols-[1fr_210px_210px] gap-3"><input className="input" value={q} onChange={e=>setQ(e.target.value)} placeholder="Tìm action / key..."/><div className="panel rounded-xl px-4 py-3"><div className="text-[8px] font-black text-zinc-600">RULES</div><div className="mt-1 text-xl font-black">{policy.rules.length}</div></div><div className={`panel rounded-xl px-4 py-3 ${conflicts.length?'border-amber-500/30':''}`}><div className="text-[8px] font-black text-zinc-600">CONFLICT</div><div className={`mt-1 text-xl font-black ${conflicts.length?'text-amber-300':'text-emerald-300'}`}>{conflicts.length}</div></div></div>{conflicts.length>0&&<div className="mt-3 rounded-xl border border-amber-500/25 bg-amber-500/5 p-3 text-[10px] text-amber-200">{conflicts.map(([key,ids])=><div key={key}><b>{key}</b> → {ids.join(' · ')}</div>)}</div>}<section className="panel mt-4 overflow-hidden rounded-2xl"><div className="grid grid-cols-[64px_minmax(240px,1.2fr)_minmax(180px,.8fr)_220px_120px_70px] gap-3 border-b border-zinc-800 bg-zinc-950 px-4 py-3 text-[8px] font-black text-zinc-600"><span>ON</span><span>ACTION / LABEL</span><span>KEY</span><span>CAPTURE</span><span>MODE</span><span/></div>{visible.map(({r,i})=><div key={`${r.id}-${i}`} className={`grid grid-cols-[64px_minmax(240px,1.2fr)_minmax(180px,.8fr)_220px_120px_70px] items-center gap-3 border-b border-zinc-900 px-4 py-3 ${r.enabled?'':'opacity-45'}`}><button onClick={()=>patch(i,{enabled:!r.enabled})} className={`h-9 rounded-xl border text-[9px] font-black ${r.enabled?'border-emerald-500/30 bg-emerald-500/10 text-emerald-300':'border-zinc-800 bg-zinc-950 text-zinc-600'}`}>{r.enabled?'ON':'OFF'}</button><div className="grid grid-cols-2 gap-2"><input className="input" value={r.id} onChange={e=>patch(i,{id:e.target.value})} placeholder="key_mod.action"/><input className="input" value={r.label} onChange={e=>patch(i,{label:e.target.value})} placeholder="Tên hiển thị"/></div><input className="input font-mono text-[10px]" value={r.key} onChange={e=>patch(i,{key:e.target.value})}/><button onClick={()=>setCapture(i)} className={`rounded-xl border px-3 py-3 text-[9px] font-black ${capture===i?'border-red-500 bg-red-500/10 text-red-300':'border-zinc-700 bg-zinc-900 text-zinc-300'}`}>{capture===i?'NHẤN PHÍM...':'GHI PHÍM BÀN PHÍM'}</button><select className="input" value={r.mode} onChange={e=>patch(i,{mode:e.target.value as KeybindRule['mode']})}><option value="default">DEFAULT</option><option value="locked">LOCKED</option></select><button onClick={()=>remove(i)} className="rounded-lg px-2 py-2 text-[9px] font-black text-red-400 hover:bg-red-500/10">GỠ</button></div>)}</section><div className="mt-3 text-[9px] leading-4 text-zinc-600">Mouse/gamepad hoặc mã phím đặc biệt vẫn có thể nhập trực tiếp theo format Minecraft, ví dụ <b>key.mouse.4</b>. Policy không ghi đè volume, FOV, graphics hay language.</div></div>;
}

